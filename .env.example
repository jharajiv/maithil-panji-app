# --- AI interviewer (without a key the chat runs in "Simple mode") ---
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-sonnet-4-5)
ANTHROPIC_MODEL=
# Optional: max chat messages per IP per 10 minutes (default 60)
CHAT_RATE_LIMIT=

# --- Shared trees + WhatsApp invitations (without these, Share shows "not switched on yet") ---
# Supabase → Project Settings → API. Server-only secrets: never prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: enables the "Join on WhatsApp" button on the landing page
NEXT_PUBLIC_WA_COMMUNITY_URL=

# Sign-in with an email address (accounts). Without these, production keeps the device-only guest mode.
# Resend (resend.com): add and verify your domain, create an API key, then use an address on that domain as the sender.
RESEND_API_KEY=
EMAIL_FROM="PAAG Foundation <login@mail.your-domain.com>"
# optional: any long random text; makes stored sign-in code hashes unguessable even if the database leaked
AUTH_SECRET=

# --- Voluntary contribution, offered just before a family tree PDF is downloaded (all optional; with none set, nothing is asked) ---
# India: UPI link on phones, QR code on computers (amounts ₹51 / 101 / 251 / 501)
NEXT_PUBLIC_DONATE_UPI_ID=
NEXT_PUBLIC_DONATE_UPI_NAME="PAAG Foundation"
# Everyone else: a hosted payment link (Stripe Payment Link, Razorpay payment page, Buy Me a Coffee, …). May contain {amount} and {currency}.
NEXT_PUBLIC_DONATE_CARD_URL=
# Optional: a secret that makes the read-only QR-code addresses of trees unguessable (AUTH_SECRET is used if this is empty)

# ── Tester list (optional): approved friends sign in WITHOUT an email ──
# Comma-separated emails + one numeric access code (8–10 digits is best). Hand the code to each person yourself.
# Everyone not on the list still gets the normal emailed code. Needs a redeploy after changing.
TEST_LOGIN_EMAILS=
TEST_LOGIN_CODE=

# ── Public address and contact (set when your own domain is live; then redeploy) ──
# Used for the preview pictures shown when a tree link is pasted into WhatsApp / Facebook, for emails, the sitemap and search results.
# Once paag.org.in is connected in Vercel, set:  NEXT_PUBLIC_SITE_URL=https://paag.org.in
NEXT_PUBLIC_SITE_URL=
# Shown on the /privacy page so people know whom to write to
# e.g. hello@paag.org.in (create this mailbox or forwarding address first)
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Sign in with Google (optional; the emailed code keeps working) ──
# Google Cloud console → APIs & Services → OAuth consent screen (External, publish it) → Credentials → Create OAuth client ID → "Web application".
# Add as "Authorised redirect URI":  https://<your-domain>/api/auth/google/callback   (add one for every address the site is served from,
# e.g. the vercel.app address and the final domain). Only the email address and name are requested.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Admin tools (/admin: find people by any attribute, trace how two people are connected) ──
# Comma-separated emails of the site's operators. They must sign in with that address.
ADMIN_EMAILS=

# ── Village / town suggestions from Google Places (optional; without it the free OpenStreetMap service is used) ──
# Google Cloud console → APIs & Services → enable "Places API (New)" → Credentials → Create API key.
# Restrict the key to "Places API (New)" only, and set a daily quota / budget alert so a surprise bill is impossible.
# The key stays on the server (never sent to the browser). Do NOT prefix it with NEXT_PUBLIC_.
GOOGLE_PLACES_API_KEY=
