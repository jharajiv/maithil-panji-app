# --- AI interviewer (without a key the chat runs in "Simple mode") ---
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-sonnet-4-5)
ANTHROPIC_MODEL=
# Optional: max chat messages per IP per 10 minutes (default 60)
CHAT_RATE_LIMIT=

# --- Shared trees + WhatsApp invitations (without these, Share shows "not switched on yet") ---
# Supabase → Project Settings → API. Server-only secrets: never prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: enables the "Join on WhatsApp" button on the landing page
NEXT_PUBLIC_WA_COMMUNITY_URL=
